[Unit]
Description=Independent encrypted software recovery copy
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/local/bin/node /opt/arena-recovery/services/recovery/recovery.mjs /etc/vynor/arena-recovery/config.json
TimeoutStartSec=45min
Nice=10
IOSchedulingClass=idle
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/vynor/arena-recovery /etc/vynor/arena-recovery
ProtectHome=read-only
