[Unit]
Description=Isolated point-in-time database recovery drill
After=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/local/bin/node /opt/arena-recovery/services/recovery/pitr-drill.mjs /etc/vynor/arena-recovery/config.json
TimeoutStartSec=60min
Nice=10
IOSchedulingClass=idle
