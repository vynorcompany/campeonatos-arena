[Unit]
Description=Continuous database archive health
After=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/local/bin/node /opt/arena-recovery/services/recovery/monitor.mjs /etc/vynor/arena-recovery/config.json
TimeoutStartSec=3min
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/vynor/arena-recovery /etc/vynor/arena-recovery
PrivateTmp=true
