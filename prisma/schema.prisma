generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  systemRole   String       @default("ADMIN")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  sessions     Session[]
  memberships  ArenaMember[]
  createdArenas Arena[]     @relation("ArenaCreator")
  openedTickets SupportTicket[] @relation("TicketRequester")
  assignedTickets SupportTicket[] @relation("TicketAssignee")
  ticketMessages SupportTicketMessage[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  email       String   @id
  failedCount Int      @default(0)
  lockedUntil DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([lockedUntil])
}

model Arena {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  legalName   String        @default("")
  cnpj        String        @default("")
  phone       String        @default("")
  email       String        @default("")
  address     String        @default("")
  city        String        @default("")
  state       String        @default("")
  zipCode     String        @default("")
  logoUrl     String        @default("/arena-profile.jpg")
  accountStatus String      @default("ACTIVE")
  agencyNotes String        @default("")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdById String
  createdBy   User          @relation("ArenaCreator", fields: [createdById], references: [id])
  members     ArenaMember[]
  players     Player[]
  tournaments Tournament[]
  manualUpcomingMatches ManualUpcomingMatch[]
  students    Student[]
  teachers    Teacher[]
  lessons     Lesson[]
  products    Product[]
  sales       Sale[]
  stockMovements StockMovement[]
  plans       Plan[]
  subscriptions StudentSubscription[]
  financialEntries FinancialEntry[]
  payrollEntries TeacherPayrollEntry[]
  supportTickets SupportTicket[]
  tvPresentationSettings TvPresentationSettings?
  tvSponsors    TvSponsor[]
}

model SupportTicket {
  id          String   @id @default(cuid())
  code        String   @unique
  title       String
  description String
  category    String   @default("SUPPORT")
  priority    String   @default("MEDIUM")
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  resolvedAt  DateTime?
  arenaId     String
  requesterId String
  assigneeId  String?
  arena       Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  requester   User     @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  assignee    User?    @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages    SupportTicketMessage[]

  @@index([arenaId, status])
  @@index([status, priority])
  @@index([assigneeId])
  @@index([requesterId])
}

model SupportTicketMessage {
  id        String   @id @default(cuid())
  body      String
  internal  Boolean  @default(false)
  createdAt DateTime @default(now())
  ticketId  String
  authorId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@index([authorId])
}

model ArenaMember {
  id              String   @id @default(cuid())
  role            String   @default("STAFF")
  viewPermissions String[] @default([])
  editPermissions String[] @default([])
  createdAt       DateTime @default(now())
  userId          String
  arenaId         String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  arena           Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)

  @@unique([userId, arenaId])
  @@index([arenaId])
}

model Player {
  id          String            @id @default(cuid())
  name        String
  points      Int               @default(1000)
  photoUrl    String            @default("")
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  arenaId     String
  arena       Arena             @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  entries     TournamentPlayer[]
  pairPlayers PairPlayer[]
  student     Student?

  @@unique([arenaId, name])
  @@index([arenaId, active])
  @@index([arenaId, points])
}

model Tournament {
  id          String            @id @default(cuid())
  name        String
  status      String            @default("DRAFT")
  groupCount  Int               @default(2)
  pairsPerGroup Int             @default(3)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  arenaId     String
  arena       Arena             @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  entries     TournamentPlayer[]
  pairs       Pair[]
  groups      TournamentGroup[]
  matches     Match[]

  @@index([arenaId, status])
  @@index([arenaId, createdAt])
}

model TournamentPlayer {
  id               String     @id @default(cuid())
  seedPoints       Int
  tournamentPoints Int        @default(0)
  createdAt        DateTime   @default(now())
  tournamentId     String
  playerId         String
  tournament       Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player           Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, playerId])
  @@index([tournamentId, seedPoints])
  @@index([playerId])
}

model Pair {
  id            String      @id @default(cuid())
  name          String
  totalPoints   Int
  drawOrder     Int
  createdAt     DateTime    @default(now())
  tournamentId  String
  groupId       String?
  tournament    Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  group         TournamentGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  players       PairPlayer[]
  homeMatches   Match[]     @relation("HomePair")
  awayMatches   Match[]     @relation("AwayPair")
  winnerMatches Match[]     @relation("WinnerPair")

  @@index([tournamentId, drawOrder])
  @@index([tournamentId, totalPoints])
  @@index([groupId])
}

model PairPlayer {
  id       String @id @default(cuid())
  pairId   String
  playerId String
  slot     Int
  pair     Pair   @relation(fields: [pairId], references: [id], onDelete: Cascade)
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([pairId, playerId])
  @@unique([pairId, slot])
}

model TournamentGroup {
  id           String      @id @default(cuid())
  name         String
  drawOrder    Int
  tournamentId String
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  pairs        Pair[]
  matches      Match[]

  @@unique([tournamentId, name])
  @@index([tournamentId, drawOrder])
}

model Match {
  id            String          @id @default(cuid())
  label         String
  stage         String
  roundOrder    Int
  courtName     String?
  scheduledTime String?
  homeScore     Int?
  awayScore     Int?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  tournamentId  String
  groupId       String?
  homePairId    String?
  awayPairId    String?
  winnerPairId  String?
  tournament    Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  group         TournamentGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  homePair      Pair?           @relation("HomePair", fields: [homePairId], references: [id], onDelete: SetNull)
  awayPair      Pair?           @relation("AwayPair", fields: [awayPairId], references: [id], onDelete: SetNull)
  winnerPair    Pair?           @relation("WinnerPair", fields: [winnerPairId], references: [id], onDelete: SetNull)

  @@index([tournamentId, stage, roundOrder])
  @@index([groupId])
  @@index([winnerPairId])
}

model ManualUpcomingMatch {
  id           String   @id @default(cuid())
  homePairName String   @default("")
  awayPairName String   @default("")
  courtName    String   @default("")
  scheduledTime String   @default("")
  status       String   @default("SCHEDULED")
  displayOrder Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  arenaId      String
  arena        Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)

  @@index([arenaId, displayOrder])
}

model TvPresentationSettings {
  id                     String   @id @default(cuid())
  slideIntervalSeconds   Int      @default(12)
  selectedTournamentId   String?
  showMatches            Boolean  @default(true)
  showSponsors           Boolean  @default(false)
  showRanking            Boolean  @default(false)
  showMonthlyPrize       Boolean  @default(false)
  showNightWinner        Boolean  @default(false)
  monthlyPrizeTitle      String   @default("Premiacao mensal")
  monthlyPrizeAmount     String   @default("1° - R$200 em credito da arena")
  monthlyPrizeDescription String  @default("2° - Um tubo de bolinha + R$50 em credito da arena | 3° - Um grip + R$25 em credito")
  nightWinnerTitle       String   @default("Vencedor da noite")
  nightWinnerName        String   @default("Super 12")
  nightWinnerDescription String   @default("Ganha uma vaga cortesia para o Super 12 da proxima semana. O uso e obrigatorio na semana seguinte.")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  arenaId                String   @unique
  arena                  Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)
}

model TvSponsor {
  id          String   @id @default(cuid())
  name        String
  subtitle    String   @default("")
  logoUrl     String   @default("")
  displayOrder Int     @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  arenaId     String
  arena       Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)

  @@index([arenaId, displayOrder])
}

model Student {
  id             String   @id @default(cuid())
  name           String
  phone          String   @default("")
  email          String   @default("")
  remainingClasses Int    @default(0)
  totalClasses   Int      @default(0)
  attendedClasses Int     @default(0)
  missedClasses  Int      @default(0)
  active         Boolean  @default(true)
  notes          String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  arenaId        String
  playerId       String?
  arena          Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  player         Player?  @relation(fields: [playerId], references: [id], onDelete: SetNull)
  attendances    LessonAttendance[]
  subscriptions  StudentSubscription[]

  @@unique([arenaId, name])
  @@unique([playerId])
  @@index([arenaId, active])
}

model Teacher {
  id             String   @id @default(cuid())
  name           String
  phone          String   @default("")
  email          String   @default("")
  monthlyTarget  Int      @default(0)
  active         Boolean  @default(true)
  notes          String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  arenaId        String
  arena          Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  lessons        Lesson[]
  payrollEntries TeacherPayrollEntry[]

  @@unique([arenaId, name])
  @@index([arenaId, active])
}

model Lesson {
  id              String   @id @default(cuid())
  title           String
  scheduledAt     DateTime?
  durationMinutes Int      @default(60)
  status          String   @default("SCHEDULED")
  priceCents      Int      @default(0)
  paymentMethod   String   @default("")
  paidAt          DateTime?
  notes           String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  arenaId         String
  teacherId       String?
  arena           Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  teacher         Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  attendances     LessonAttendance[]

  @@index([arenaId, scheduledAt])
  @@index([teacherId])
}

model LessonAttendance {
  id        String  @id @default(cuid())
  status    String  @default("PRESENT")
  lessonId  String
  studentId String
  lesson    Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, studentId])
  @@index([studentId])
}

model Product {
  id            String   @id @default(cuid())
  name          String
  sku           String   @default("")
  priceCents    Int      @default(0)
  stockQuantity Int      @default(0)
  minStock      Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  arenaId       String
  arena         Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  saleItems     SaleItem[]
  stockMovements StockMovement[]

  @@unique([arenaId, name])
  @@index([arenaId, active])
  @@index([arenaId, stockQuantity])
}

model Sale {
  id            String   @id @default(cuid())
  code          String   @unique
  customerName  String   @default("")
  paymentMethod String
  status        String   @default("PAID")
  totalCents    Int
  createdAt     DateTime @default(now())
  arenaId       String
  arena         Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  items         SaleItem[]

  @@index([arenaId, createdAt])
}

model SaleItem {
  id             String  @id @default(cuid())
  quantity       Int
  unitPriceCents Int
  totalCents     Int
  saleId         String
  productId      String
  sale           Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
}

model StockMovement {
  id        String   @id @default(cuid())
  type      String
  quantity  Int
  reason    String   @default("")
  createdAt DateTime @default(now())
  arenaId   String
  productId String
  arena     Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([arenaId, createdAt])
  @@index([productId])
}

model Plan {
  id                String   @id @default(cuid())
  name              String
  monthlyPriceCents Int      @default(0)
  classesPerMonth   Int      @default(0)
  active            Boolean  @default(true)
  notes             String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  arenaId           String
  arena             Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  subscriptions     StudentSubscription[]

  @@unique([arenaId, name])
  @@index([arenaId, active])
}

model StudentSubscription {
  id                String   @id @default(cuid())
  status            String   @default("ACTIVE")
  monthlyPriceCents Int      @default(0)
  classesPerMonth   Int      @default(0)
  dueDay            Int      @default(10)
  startedAt         DateTime @default(now())
  endedAt           DateTime?
  notes             String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  arenaId           String
  studentId         String
  planId            String
  arena             Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  plan              Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([arenaId, status])
  @@index([planId])
  @@index([studentId, status])
}

model FinancialEntry {
  id            String   @id @default(cuid())
  type          String
  category      String
  description   String
  amountCents   Int
  paymentMethod String   @default("")
  status        String   @default("PENDING")
  dueDate       DateTime?
  paidAt        DateTime?
  notes         String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  arenaId       String
  arena         Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)

  @@index([arenaId, type, status])
  @@index([arenaId, dueDate])
  @@index([arenaId, paidAt])
}

model TeacherPayrollEntry {
  id                 String   @id @default(cuid())
  referenceMonth     String
  fixedSalaryCents   Int      @default(0)
  classValueCents    Int      @default(0)
  bonusCents         Int      @default(0)
  discountCents      Int      @default(0)
  paidCents          Int      @default(0)
  status             String   @default("PENDING")
  notes              String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  arenaId            String
  teacherId          String
  arena              Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  teacher            Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, referenceMonth])
  @@index([arenaId, referenceMonth])
  @@index([arenaId, status])
}
