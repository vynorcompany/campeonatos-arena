generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CompetitionFormat {
  LEAGUE
  THREE_GROUPS
  FOUR_GROUPS
  SIMPLE
}

enum RankingType {
  INDIVIDUAL
  PAIR
}

enum RankingModel {
  LEAGUE
  KNOCKOUT
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  systemRole   String       @default("ADMIN")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  sessions     Session[]
  memberships  ArenaMember[]
  createdArenas Arena[]     @relation("ArenaCreator")
  openedTickets SupportTicket[] @relation("TicketRequester")
  assignedTickets SupportTicket[] @relation("TicketAssignee")
  ticketMessages SupportTicketMessage[]
  regulationAcceptances RegulationAcceptance[] @relation("RegulationAcceptedBy")
  regulationDocuments RegulationDocument[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  email       String   @id
  failedCount Int      @default(0)
  lockedUntil DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([lockedUntil])
}

model Arena {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  legalName   String        @default("")
  cnpj        String        @default("")
  phone       String        @default("")
  email       String        @default("")
  address     String        @default("")
  city        String        @default("")
  state       String        @default("")
  zipCode     String        @default("")
  logoUrl     String        @default("/arena-profile.jpg")
  accountStatus String      @default("ACTIVE")
  agencyNotes String        @default("")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdById String
  createdBy   User          @relation("ArenaCreator", fields: [createdById], references: [id])
  members     ArenaMember[]
  players     Player[]
  rankings    RankingProfile[]
  tournaments Tournament[]
  manualUpcomingMatches ManualUpcomingMatch[]
  students    Student[]
  teachers    Teacher[]
  lessons     Lesson[]
  calendarEvents CalendarEvent[]
  products    Product[]
  sales       Sale[]
  stockMovements StockMovement[]
  plans       Plan[]
  subscriptions StudentSubscription[]
  financialEntries FinancialEntry[]
  payrollEntries TeacherPayrollEntry[]
  supportTickets SupportTicket[]
  tvPresentationSettings TvPresentationSettings?
  tvSponsors    TvSponsor[]
  regulationAcceptances RegulationAcceptance[]
  regulationDocuments RegulationDocument[]
}

model RegulationAcceptance {
  id            String   @id @default(cuid())
  content       String
  acceptedAt    DateTime @default(now())
  arenaId       String
  acceptedById  String?
  regulationDocumentId String?
  arena         Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  acceptedBy    User?    @relation("RegulationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  regulationDocument RegulationDocument? @relation(fields: [regulationDocumentId], references: [id], onDelete: SetNull)

  @@index([arenaId, acceptedAt])
  @@index([acceptedById])
  @@index([regulationDocumentId])
}

model RegulationDocument {
  id          String   @id @default(cuid())
  content     String
  publicSlug  String   @unique
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  arenaId     String
  createdById String?
  arena       Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  acceptances RegulationAcceptance[]

  @@index([arenaId, active])
  @@index([arenaId, createdAt])
}

model SupportTicket {
  id          String   @id @default(cuid())
  code        String   @unique
  title       String
  description String
  category    String   @default("SUPPORT")
  priority    String   @default("MEDIUM")
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  resolvedAt  DateTime?
  arenaId     String
  requesterId String
  assigneeId  String?
  arena       Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  requester   User     @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  assignee    User?    @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages    SupportTicketMessage[]

  @@index([arenaId, status])
  @@index([status, priority])
  @@index([assigneeId])
  @@index([requesterId])
}

model SupportTicketMessage {
  id        String   @id @default(cuid())
  body      String
  internal  Boolean  @default(false)
  createdAt DateTime @default(now())
  ticketId  String
  authorId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@index([authorId])
}

model ArenaMember {
  id              String   @id @default(cuid())
  role            String   @default("STAFF")
  viewPermissions String[] @default([])
  editPermissions String[] @default([])
  createdAt       DateTime @default(now())
  userId          String
  arenaId         String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  arena           Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)

  @@unique([userId, arenaId])
  @@index([arenaId])
}

model Player {
  id          String            @id @default(cuid())
  name        String
  points      Int               @default(1000)
  photoUrl    String            @default("")
  class       String            @default("") @map("category")
  gender      String            @default("")
  phone       String            @default("")
  cpf         String            @default("")
  birthDate   DateTime?
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  arenaId     String
  arena       Arena             @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  entries     TournamentPlayer[]
  pairPlayers PairPlayer[]
  categoryPairPlayers CategoryPairPlayer[]
  student     Student?

  @@unique([arenaId, name])
  @@index([arenaId, active])
  @@index([arenaId, points])
}

model Tournament {
  id          String            @id @default(cuid())
  name        String
  description String            @default("")
  publicSlug  String            @unique @default(cuid())
  creationMode String           @default("MANUAL")
  status      String            @default("DRAFT")
  registrationPhase String      @default("REGISTRATIONS")
  groupCount  Int               @default(2)
  pairsPerGroup Int             @default(3)
  priceFirstCents Int           @default(0)
  priceSecondCents Int          @default(0)
  priceThirdCents Int           @default(0)
  blockCategoryGap Boolean      @default(false)
  maxCategoryGap Int            @default(1)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  arenaId     String
  rankingId   String?
  arena       Arena             @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  ranking     RankingProfile?   @relation(fields: [rankingId], references: [id], onDelete: SetNull)
  entries     TournamentPlayer[]
  pairs       Pair[]
  groups      TournamentGroup[]
  matches     Match[]
  categories  TournamentCategory[]
  publicRegistrations PublicTournamentRegistration[]
  categoryBrackets CategoryBracket[]

  @@index([arenaId, status])
  @@index([arenaId, createdAt])
  @@index([rankingId])
}

model TournamentCategory {
  id           String     @id @default(cuid())
  name         String
  level        Int
  class        String     @default("")
  gender       String     @default("")
  groupCount   Int        @default(4)
  pairsPerGroup Int       @default(3)
  priceSecondCents Int    @default(0)
  priceThirdCents Int     @default(0)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  competition  CategoryCompetition?
  registrations PublicTournamentRegistration[]
  brackets     CategoryBracket[]

  @@unique([tournamentId, name])
  @@unique([tournamentId, level])
  @@index([tournamentId, level])
}

model PublicTournamentRegistration {
  id                  String   @id @default(cuid())
  leadName            String
  leadPhone           String
  leadCpf             String
  leadBirthDate       DateTime
  partnerName         String
  partnerPhone        String
  partnerCpf          String
  partnerBirthDate    DateTime
  registrationOrder   Int
  amountCents         Int
  paymentStatus       String   @default("PENDING")
  paymentProvider     String   @default("")
  paymentReference    String   @default("")
  mercadoPagoPaymentId String  @default("")
  paymentQrCode       String   @default("")
  paymentQrCodeBase64 String   @default("")
  paymentCheckoutUrl  String   @default("")
  paymentExpiresAt    DateTime?
  status              String   @default("PENDING_PAYMENT")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  tournamentId        String
  categoryId          String
  competitionId       String?
  tournament          Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  category            TournamentCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  competition         CategoryCompetition? @relation(fields: [competitionId, categoryId], references: [id, categoryId], onDelete: Cascade)
  homeBracketMatches  CategoryBracketMatch[] @relation("CategoryBracketHome")
  awayBracketMatches  CategoryBracketMatch[] @relation("CategoryBracketAway")
  winnerBracketMatches CategoryBracketMatch[] @relation("CategoryBracketWinner")

  @@index([tournamentId, createdAt])
  @@index([categoryId, createdAt])
  @@index([leadCpf, createdAt])
  @@index([partnerCpf, createdAt])
  @@index([competitionId, createdAt])
}

model CategoryBracket {
  id           String   @id @default(cuid())
  status       String   @default("DRAFT")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tournamentId String
  categoryId   String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  category     TournamentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  matches      CategoryBracketMatch[]

  @@unique([tournamentId, categoryId])
  @@index([categoryId, createdAt])
}

model CategoryBracketMatch {
  id                 String   @id @default(cuid())
  label              String
  roundOrder         Int
  stage              String
  courtName          String   @default("")
  scheduledTime      String   @default("")
  status             String   @default("WAITING")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  bracketId          String
  homeRegistrationId String?
  awayRegistrationId String?
  winnerRegistrationId String?
  bracket            CategoryBracket @relation(fields: [bracketId], references: [id], onDelete: Cascade)
  homeRegistration   PublicTournamentRegistration? @relation("CategoryBracketHome", fields: [homeRegistrationId], references: [id], onDelete: SetNull)
  awayRegistration   PublicTournamentRegistration? @relation("CategoryBracketAway", fields: [awayRegistrationId], references: [id], onDelete: SetNull)
  winnerRegistration PublicTournamentRegistration? @relation("CategoryBracketWinner", fields: [winnerRegistrationId], references: [id], onDelete: SetNull)

  @@index([bracketId, roundOrder])
  @@index([homeRegistrationId])
  @@index([awayRegistrationId])
  @@index([winnerRegistrationId])
}

model RankingProfile {
  id          String        @id @default(cuid())
  name        String
  description String        @default("")
  active      Boolean       @default(true)
  type        RankingType   @default(PAIR)
  model       RankingModel  @default(KNOCKOUT)
  isGeneral   Boolean       @default(false)
  feedsGeneralRanking Boolean @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  arenaId     String
  arena       Arena         @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  rules       RankingRule[]
  tournaments Tournament[]
  competitions CategoryCompetition[]
  categoryApplications CategoryRankingApplication[]
  cycles      RankingCycle[]

  @@unique([arenaId, name])
  @@index([arenaId, active])
  @@index([arenaId, isGeneral])
}

model RankingRule {
  id          String         @id @default(cuid())
  stageKey    String
  label       String
  points      Int
  displayOrder Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  rankingId   String
  ranking     RankingProfile @relation(fields: [rankingId], references: [id], onDelete: Cascade)

  @@unique([rankingId, stageKey])
  @@index([rankingId, displayOrder])
}

model RankingCycle {
  id         String         @id @default(cuid())
  label      String         @default("")
  startedAt  DateTime       @default(now())
  endedAt    DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  rankingId  String
  ranking    RankingProfile @relation(fields: [rankingId], references: [id], onDelete: Cascade)

  @@index([rankingId, startedAt])
  @@index([rankingId, endedAt])
}

model CategoryCompetition {
  id                  String                         @id @default(cuid())
  format              CompetitionFormat
  status              String                         @default("DRAFT")
  feedsGeneralRanking Boolean                        @default(false)
  isPublic            Boolean                        @default(false)
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt
  categoryId          String                         @unique
  rankingId           String?
  category            TournamentCategory             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  ranking             RankingProfile?                @relation(fields: [rankingId], references: [id], onDelete: SetNull)
  registrations       PublicTournamentRegistration[]
  pairs               CategoryPair[]
  groups              CategoryGroup[]
  matches             CategoryMatch[]
  application         CategoryRankingApplication?

  @@index([rankingId])
  @@index([status])
  @@unique([id, categoryId])
}

model CategoryRankingApplication {
  id                  String              @id @default(cuid())
  feedsGeneralRanking Boolean
  appliedAt           DateTime            @default(now())
  competitionId       String              @unique
  rankingId           String?
  competition         CategoryCompetition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  ranking             RankingProfile?     @relation(fields: [rankingId], references: [id], onDelete: SetNull)

  @@index([rankingId])
}

model CategoryPair {
  id            String               @id @default(cuid())
  name          String
  totalPoints   Int                  @default(0)
  drawOrder     Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  competitionId String
  groupId       String?
  competition   CategoryCompetition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  group         CategoryGroup?       @relation(fields: [groupId, competitionId], references: [id, competitionId], onDelete: NoAction)
  players       CategoryPairPlayer[]
  homeMatches   CategoryMatch[]      @relation("CategoryHomePair")
  awayMatches   CategoryMatch[]      @relation("CategoryAwayPair")
  winnerMatches CategoryMatch[]      @relation("CategoryWinnerPair")

  @@index([competitionId, drawOrder])
  @@index([competitionId, totalPoints])
  @@index([groupId])
  @@unique([id, competitionId])
}

model CategoryPairPlayer {
  id            String       @id @default(cuid())
  pairId        String
  competitionId String
  playerId      String
  slot          Int
  pair          CategoryPair @relation(fields: [pairId, competitionId], references: [id, competitionId], onDelete: Cascade)
  player        Player       @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([pairId, playerId])
  @@unique([pairId, slot])
  @@unique([competitionId, playerId])
  @@index([playerId])
}

model CategoryGroup {
  id            String              @id @default(cuid())
  name          String
  drawOrder     Int
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  competitionId String
  competition   CategoryCompetition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  pairs         CategoryPair[]
  matches       CategoryMatch[]

  @@unique([competitionId, name])
  @@index([competitionId, drawOrder])
  @@unique([id, competitionId])
}

model CategoryMatch {
  id            String              @id @default(cuid())
  label         String
  stage         String
  roundOrder    Int
  courtName     String?
  scheduledDate String?
  scheduledTime String?
  homeScore     Int?
  awayScore     Int?
  homeSet1      Int?
  awaySet1      Int?
  homeSet2      Int?
  awaySet2      Int?
  homeSet3      Int?
  awaySet3      Int?
  manualStatus  String?
  showOnTv      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  competitionId String
  groupId       String?
  homePairId    String?
  awayPairId    String?
  winnerPairId  String?
  competition   CategoryCompetition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  group         CategoryGroup?      @relation(fields: [groupId, competitionId], references: [id, competitionId], onDelete: NoAction)
  homePair      CategoryPair?       @relation("CategoryHomePair", fields: [homePairId, competitionId], references: [id, competitionId], onDelete: NoAction)
  awayPair      CategoryPair?       @relation("CategoryAwayPair", fields: [awayPairId, competitionId], references: [id, competitionId], onDelete: NoAction)
  winnerPair    CategoryPair?       @relation("CategoryWinnerPair", fields: [winnerPairId, competitionId], references: [id, competitionId], onDelete: NoAction)

  @@index([competitionId, stage, roundOrder])
  @@index([groupId])
  @@index([winnerPairId])
}

model TournamentPlayer {
  id               String     @id @default(cuid())
  seedPoints       Int
  tournamentPoints Int        @default(0)
  createdAt        DateTime   @default(now())
  tournamentId     String
  playerId         String
  tournament       Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player           Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, playerId])
  @@index([tournamentId, seedPoints])
  @@index([playerId])
}

model Pair {
  id            String      @id @default(cuid())
  name          String
  totalPoints   Int
  drawOrder     Int
  createdAt     DateTime    @default(now())
  tournamentId  String
  groupId       String?
  tournament    Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  group         TournamentGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  players       PairPlayer[]
  homeMatches   Match[]     @relation("HomePair")
  awayMatches   Match[]     @relation("AwayPair")
  winnerMatches Match[]     @relation("WinnerPair")

  @@index([tournamentId, drawOrder])
  @@index([tournamentId, totalPoints])
  @@index([groupId])
}

model PairPlayer {
  id       String @id @default(cuid())
  pairId   String
  playerId String
  slot     Int
  pair     Pair   @relation(fields: [pairId], references: [id], onDelete: Cascade)
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([pairId, playerId])
  @@unique([pairId, slot])
}

model TournamentGroup {
  id           String      @id @default(cuid())
  name         String
  drawOrder    Int
  tournamentId String
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  pairs        Pair[]
  matches      Match[]

  @@unique([tournamentId, name])
  @@index([tournamentId, drawOrder])
}

model Match {
  id            String          @id @default(cuid())
  label         String
  stage         String
  roundOrder    Int
  courtName     String?
  scheduledTime String?
  homeScore     Int?
  awayScore     Int?
  manualStatus  String?
  showOnTv      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  tournamentId  String
  groupId       String?
  homePairId    String?
  awayPairId    String?
  winnerPairId  String?
  tournament    Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  group         TournamentGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  homePair      Pair?           @relation("HomePair", fields: [homePairId], references: [id], onDelete: SetNull)
  awayPair      Pair?           @relation("AwayPair", fields: [awayPairId], references: [id], onDelete: SetNull)
  winnerPair    Pair?           @relation("WinnerPair", fields: [winnerPairId], references: [id], onDelete: SetNull)

  @@index([tournamentId, stage, roundOrder])
  @@index([groupId])
  @@index([winnerPairId])
}

model ManualUpcomingMatch {
  id           String   @id @default(cuid())
  homePairName String   @default("")
  awayPairName String   @default("")
  courtName    String   @default("")
  scheduledTime String   @default("")
  status       String   @default("SCHEDULED")
  displayOrder Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  arenaId      String
  arena        Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)

  @@index([arenaId, displayOrder])
}

model TvPresentationSettings {
  id                     String   @id @default(cuid())
  slideIntervalSeconds   Int      @default(12)
  selectedTournamentId   String?
  selectedRankingIds     String[] @default([])
  rankingTitle           String   @default("")
  showMatches            Boolean  @default(true)
  tvMatchSource          String   @default("MANUAL")
  showCalendar           Boolean  @default(false)
  showSponsors           Boolean  @default(false)
  showRanking            Boolean  @default(false)
  showMonthlyPrize       Boolean  @default(false)
  showNightWinner        Boolean  @default(false)
  monthlyPrizeTitle      String   @default("Premiacao mensal")
  monthlyPrizeAmount     String   @default("1° - R$200 em credito da arena")
  monthlyPrizeDescription String  @default("2° - Um tubo de bolinha + R$50 em credito da arena | 3° - Um grip + R$25 em credito")
  nightWinnerTitle       String   @default("Vencedor da noite")
  nightWinnerName        String   @default("Super 12")
  nightWinnerDescription String   @default("Ganha uma vaga cortesia para o Super 12 da proxima semana. O uso e obrigatorio na semana seguinte.")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  arenaId                String   @unique
  arena                  Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)
}

model TvSponsor {
  id          String   @id @default(cuid())
  name        String
  subtitle    String   @default("")
  logoUrl     String   @default("")
  displayOrder Int     @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  arenaId     String
  arena       Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)

  @@index([arenaId, displayOrder])
}

model Student {
  id             String   @id @default(cuid())
  name           String
  phone          String   @default("")
  email          String   @default("")
  remainingClasses Int    @default(0)
  totalClasses   Int      @default(0)
  attendedClasses Int     @default(0)
  missedClasses  Int      @default(0)
  active         Boolean  @default(true)
  notes          String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  arenaId        String
  playerId       String?
  arena          Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  player         Player?  @relation(fields: [playerId], references: [id], onDelete: SetNull)
  attendances    LessonAttendance[]
  subscriptions  StudentSubscription[]

  @@unique([arenaId, name])
  @@unique([playerId])
  @@index([arenaId, active])
}

model Teacher {
  id             String   @id @default(cuid())
  name           String
  phone          String   @default("")
  email          String   @default("")
  monthlyTarget  Int      @default(0)
  active         Boolean  @default(true)
  notes          String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  arenaId        String
  arena          Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  lessons        Lesson[]
  payrollEntries TeacherPayrollEntry[]

  @@unique([arenaId, name])
  @@index([arenaId, active])
}

model Lesson {
  id              String   @id @default(cuid())
  title           String
  scheduledAt     DateTime?
  durationMinutes Int      @default(60)
  status          String   @default("SCHEDULED")
  priceCents      Int      @default(0)
  paymentMethod   String   @default("")
  paidAt          DateTime?
  notes           String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  arenaId         String
  teacherId       String?
  arena           Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  teacher         Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  attendances     LessonAttendance[]

  @@index([arenaId, scheduledAt])
  @@index([teacherId])
}

model CalendarEvent {
  id              String   @id @default(cuid())
  eventType       String   @default("EVENTO")
  title           String
  scheduledAt     DateTime
  durationMinutes Int      @default(60)
  notes           String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  arenaId         String
  arena           Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)

  @@index([arenaId, scheduledAt])
  @@index([arenaId, eventType])
}

model LessonAttendance {
  id        String  @id @default(cuid())
  status    String  @default("PRESENT")
  lessonId  String
  studentId String
  lesson    Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, studentId])
  @@index([studentId])
}

model Product {
  id            String   @id @default(cuid())
  name          String
  sku           String   @default("")
  priceCents    Int      @default(0)
  stockQuantity Int      @default(0)
  minStock      Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  arenaId       String
  arena         Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  saleItems     SaleItem[]
  stockMovements StockMovement[]

  @@unique([arenaId, name])
  @@index([arenaId, active])
  @@index([arenaId, stockQuantity])
}

model Sale {
  id            String   @id @default(cuid())
  code          String   @unique
  customerName  String   @default("")
  paymentMethod String
  status        String   @default("PAID")
  totalCents    Int
  createdAt     DateTime @default(now())
  arenaId       String
  arena         Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  items         SaleItem[]

  @@index([arenaId, createdAt])
}

model SaleItem {
  id             String  @id @default(cuid())
  quantity       Int
  unitPriceCents Int
  totalCents     Int
  saleId         String
  productId      String
  sale           Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
}

model StockMovement {
  id        String   @id @default(cuid())
  type      String
  quantity  Int
  reason    String   @default("")
  createdAt DateTime @default(now())
  arenaId   String
  productId String
  arena     Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([arenaId, createdAt])
  @@index([productId])
}

model Plan {
  id                String   @id @default(cuid())
  name              String
  monthlyPriceCents Int      @default(0)
  classesPerMonth   Int      @default(0)
  active            Boolean  @default(true)
  notes             String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  arenaId           String
  arena             Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  subscriptions     StudentSubscription[]

  @@unique([arenaId, name])
  @@index([arenaId, active])
}

model StudentSubscription {
  id                String   @id @default(cuid())
  status            String   @default("ACTIVE")
  monthlyPriceCents Int      @default(0)
  classesPerMonth   Int      @default(0)
  dueDay            Int      @default(10)
  startedAt         DateTime @default(now())
  endedAt           DateTime?
  notes             String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  arenaId           String
  studentId         String
  planId            String
  arena             Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  plan              Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([arenaId, status])
  @@index([planId])
  @@index([studentId, status])
}

model FinancialEntry {
  id            String   @id @default(cuid())
  type          String
  category      String
  description   String
  amountCents   Int
  paymentMethod String   @default("")
  status        String   @default("PENDING")
  dueDate       DateTime?
  paidAt        DateTime?
  notes         String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  arenaId       String
  arena         Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)

  @@index([arenaId, type, status])
  @@index([arenaId, dueDate])
  @@index([arenaId, paidAt])
}

model TeacherPayrollEntry {
  id                 String   @id @default(cuid())
  referenceMonth     String
  fixedSalaryCents   Int      @default(0)
  classValueCents    Int      @default(0)
  bonusCents         Int      @default(0)
  discountCents      Int      @default(0)
  paidCents          Int      @default(0)
  status             String   @default("PENDING")
  notes              String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  arenaId            String
  teacherId          String
  arena              Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  teacher            Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, referenceMonth])
  @@index([arenaId, referenceMonth])
  @@index([arenaId, status])
}
